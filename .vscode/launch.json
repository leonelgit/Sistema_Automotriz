{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AutoFix.Api",
      "preLaunchTask": "build",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/AutoFix.Api/bin/Debug/net10.0/AutoFix.Api.dll",
      "cwd": "${workspaceFolder}/AutoFix.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    },
    {
      "name": "AutoFix.Mvc",
      "preLaunchTask": "build",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/AutoFix.Mvc/bin/Debug/net10.0/AutoFix.Mvc.dll",
      "cwd": "${workspaceFolder}/AutoFix.Mvc",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5090"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "API (compuesto)",
      "presentation": {
        "hidden": true
      },
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/AutoFix.Api/bin/Debug/net10.0/AutoFix.Api.dll",
      "cwd": "${workspaceFolder}/AutoFix.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    },
    {
      "name": "MVC (compuesto)",
      "presentation": {
        "hidden": true
      },
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/AutoFix.Mvc/bin/Debug/net10.0/AutoFix.Mvc.dll",
      "cwd": "${workspaceFolder}/AutoFix.Mvc",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5090"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Prueba de concurrencia (consola)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/AutoFix.PruebaConcurrencia/bin/Debug/net10.0/AutoFix.PruebaConcurrencia.dll",
      "cwd": "${workspaceFolder}/AutoFix.PruebaConcurrencia",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "API + MVC",
      "preLaunchTask": "build",
      "configurations": [
        "API (compuesto)",
        "MVC (compuesto)"
      ],
      "stopAll": true
    }
  ]
}