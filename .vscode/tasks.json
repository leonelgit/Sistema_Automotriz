{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/AutoFix.sln", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "ef: crear migración inicial",
      "command": "dotnet",
      "type": "process",
      "args": ["ef", "migrations", "add", "InicialAutoFix", "--project", "AutoFix.Api"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "ef: actualizar base de datos",
      "command": "dotnet",
      "type": "process",
      "args": ["ef", "database", "update", "--project", "AutoFix.Api"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
