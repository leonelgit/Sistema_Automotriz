@model DashboardDto
@{
    ViewData["Title"] = "Dashboard";
    var esCliente = User.IsInRole(Roles.Cliente);
    // State label -> css class (the API returns the label as dictionary key)
    var claseEstadoPorTexto = Enum.GetValues<EstadoOrden>().ToDictionary(e => e.Texto(), e => Ui.ClaseEstado(e));
    var maxEstado = Math.Max(1, Model.OrdenesPorEstado.Values.DefaultIfEmpty(0).Max());
}
<div class="encabezado">
    <div>
        <h1>Hola, @User.Nombre()</h1>
        <p class="sub">@(esCliente ? "Este es el estado de sus vehículos en el taller." : "Resumen del taller hoy, " + DateTime.Now.ToString("dddd d 'de' MMMM", new System.Globalization.CultureInfo("es")) + ".")</p>
    </div>
    @if (User.EsAlguno(Roles.Administrador, Roles.Recepcionista))
    {
        <a asp-controller="Ordenes" asp-action="Crear" class="btn btn-ambar"><i class="bi bi-plus-lg"></i> Nueva orden</a>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="cifra azul"><span class="chip"><i class="bi bi-wrench-adjustable"></i></span><div class="cuerpo"><div class="valor">@Model.OrdenesActivas</div><div class="etiqueta">Órdenes activas</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="cifra ambar"><span class="chip"><i class="bi bi-hourglass-split"></i></span><div class="cuerpo"><div class="valor">@Model.PresupuestosPendientes</div><div class="etiqueta">Pendientes de aprobación</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="cifra verde"><span class="chip"><i class="bi bi-check2-circle"></i></span><div class="cuerpo"><div class="valor">@Model.OrdenesFinalizadasMes</div><div class="etiqueta">Finalizadas este mes</div></div></div></div>
    <div class="col-6 col-lg-3">
        @if (esCliente)
        {
            <div class="cifra"><span class="chip"><i class="bi bi-car-front"></i></span><div class="cuerpo"><div class="valor">@Model.TotalVehiculos</div><div class="etiqueta">Mis vehículos</div></div></div>
        }
        else
        {
            <div class="cifra violeta"><span class="chip"><i class="bi bi-cash-coin"></i></span><div class="cuerpo"><div class="valor">@Ui.Dinero(Model.IngresosAprobadosMes)</div><div class="etiqueta">Presupuestos aprobados (mes)</div></div></div>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="panel h-100">
            <h2><i class="bi bi-clock-history"></i> @(esCliente ? "Mis reparaciones" : "Órdenes recientes")</h2>
            @if (!Model.OrdenesRecientes.Any())
            {
                <div class="vacio"><i class="bi bi-clipboard-x"></i><p>No hay órdenes registradas.</p></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead><tr><th>Orden</th><th>Vehículo</th><th>Servicio</th><th>Estado</th><th>Entrega estimada</th></tr></thead>
                        <tbody>
                        @foreach (var o in Model.OrdenesRecientes)
                        {
                            <tr>
                                <td><a asp-controller="Ordenes" asp-action="Detalle" asp-route-id="@o.Id" class="fw-semibold">@o.NumeroOrden</a></td>
                                <td>@o.VehiculoDescripcion</td>
                                <td>@o.TipoServicio</td>
                                <td><span class="estado @Ui.ClaseEstado(o.Estado)">@o.Estado.Texto()</span></td>
                                <td>@Ui.Fecha(o.FechaEstimadaFin)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="panel">
            <h2><i class="bi bi-bar-chart-steps"></i> Órdenes por estado</h2>
            @if (!Model.OrdenesPorEstado.Any())
            {
                <div class="vacio"><i class="bi bi-bar-chart"></i><p>Sin datos por mostrar.</p></div>
            }
            @foreach (var e in Model.OrdenesPorEstado)
            {
                var clase = claseEstadoPorTexto.GetValueOrDefault(e.Key, "");
                var pct = e.Value == 0 ? 0 : Math.Max(4, e.Value * 100 / maxEstado);
                <div class="barra-estado @clase @(e.Value == 0 ? "vacia" : "")">
                    <div class="cab"><span>@e.Key</span><strong>@e.Value</strong></div>
                    <div class="pista" role="progressbar" aria-label="@e.Key" aria-valuenow="@e.Value" aria-valuemin="0" aria-valuemax="@maxEstado"><div class="relleno" style="width:@(pct)%"></div></div>
                </div>
            }
        </div>
        @if (!esCliente)
        {
            <div class="panel p-0 border-0 shadow-none bg-transparent">
                @if (!Model.RepuestosBajoStock.Any())
                {
                    <div class="callout ok"><i class="bi bi-check-circle"></i><div><h2>Stock mínimo</h2><span class="small">Todo el inventario está sobre el mínimo.</span></div></div>
                }
                else
                {
                    <div class="callout">
                        <i class="bi bi-exclamation-triangle"></i>
                        <div class="flex-grow-1">
                            <h2>Stock mínimo · @Model.RepuestosBajoStock.Count() repuesto(s) por reponer</h2>
                            @foreach (var r in Model.RepuestosBajoStock)
                            {
                                <div class="callout-fila">
                                    <a asp-controller="Inventario" asp-action="Detalle" asp-route-id="@r.Id">@r.Nombre</a>
                                    <span class="stock-bajo">@r.Existencias / @r.StockMinimo</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="panel">
                <h2><i class="bi bi-building"></i> Resumen del taller</h2>
                <div class="resumen-lista">
                    <div class="fila"><span>Clientes</span><strong>@Model.TotalClientes</strong></div>
                    <div class="fila"><span>Vehículos</span><strong>@Model.TotalVehiculos</strong></div>
                    <div class="fila"><span>Mecánicos activos</span><strong>@Model.MecanicosActivos</strong></div>
                </div>
            </div>
        }
    </div>
</div>
