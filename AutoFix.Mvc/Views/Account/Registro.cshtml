@model RegistroRequest
@{
    ViewData["Title"] = "Registro de cliente";
    Layout = "_LayoutPublico";
}
<div class="registro-fondo">
    <div class="tarjeta">
        <div class="d-flex align-items-center gap-2 mb-3"><span class="af-logo" style="width:36px;height:36px;font-size:1.1rem"><i class="bi bi-wrench-adjustable"></i></span><span class="fw-bold" style="font-family:var(--af-font-display);font-size:1.4rem;color:var(--af-navy-900)">AutoFix</span></div>
        <h1>Crear cuenta de cliente</h1>
        <p class="text-muted mb-4">Si el taller ya registró su DUI, su cuenta se vinculará automáticamente a sus vehículos.</p>
        <form asp-action="Registro" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <div class="row g-3">
                <div class="col-12"><label asp-for="NombreCompleto" class="form-label">Nombre completo</label><input asp-for="NombreCompleto" class="form-control" /><span asp-validation-for="NombreCompleto" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="Dui" class="form-label">DUI / identificación</label><input asp-for="Dui" class="form-control" /><span asp-validation-for="Dui" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="Telefono" class="form-label">Teléfono</label><input asp-for="Telefono" class="form-control" /><span asp-validation-for="Telefono" class="text-danger small"></span></div>
                <div class="col-12"><label asp-for="Direccion" class="form-label">Dirección</label><input asp-for="Direccion" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="Email" class="form-label">Correo</label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="Password" class="form-label">Contraseña (mín. 8)</label><input asp-for="Password" type="password" class="form-control" /><span asp-validation-for="Password" class="text-danger small"></span></div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-primary">Crear cuenta</button>
                <a asp-action="Login" class="btn btn-outline-secondary">Volver</a>
            </div>
        </form>
    </div>
</div>
