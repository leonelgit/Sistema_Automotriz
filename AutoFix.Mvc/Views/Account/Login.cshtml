@model LoginRequest
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutPublico";
}
<div class="login-fondo">
    <section class="login-lado">
        <div>
            <div class="nombre"><i class="bi bi-wrench-adjustable"></i> AutoFix</div>
            <p class="mt-2 fs-5">Órdenes de reparación, presupuestos, inventario y evidencias del taller en un solo lugar.</p>
        </div>
        <ul class="list-unstyled small mb-0" style="color:#a9bbd1">
            <li><i class="bi bi-check2"></i> Seguimiento del vehículo paso a paso</li>
            <li><i class="bi bi-check2"></i> Fotografías antes y después</li>
            <li><i class="bi bi-check2"></i> Inventario sin existencias negativas</li>
        </ul>
    </section>
    <section class="login-form">
        <div class="panel">
            <h1 class="h3 mb-1">Iniciar sesión</h1>
            <p class="text-muted">Use su correo y contraseña.</p>
            <partial name="_Alertas" />
            <form asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Correo</label>
                    <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Contraseña</label>
                    <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <button class="btn btn-primary w-100">Entrar</button>
            </form>
            <hr />
            <p class="small mb-0">¿Es cliente y no tiene cuenta? <a asp-action="Registro">Regístrese aquí</a>.</p>
        </div>
    </section>
</div>
