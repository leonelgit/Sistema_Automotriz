@model List<LogDto>
@{ ViewData["Title"] = "Logs"; }
<div class="encabezado">
    <div><h1>Logs y trazabilidad</h1><p class="sub">Cada petición a la API queda registrada con usuario, endpoint, código, duración y Correlation ID (también en AutoFix.Api/logs/).</p></div>
</div>
<div class="panel">
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-4"><input name="correlationId" value="@ViewBag.CorrelationId" class="form-control mono" placeholder="Correlation ID" /></div>
        <div class="col-md-3"><input name="usuario" value="@ViewBag.Usuario" class="form-control" placeholder="Usuario" /></div>
        <div class="col-md-2"><input name="codigo" type="number" value="@ViewBag.Codigo" class="form-control" placeholder="Código HTTP" /></div>
        <div class="col-md-2 form-check d-flex align-items-center gap-2 ps-4">
            <input class="form-check-input" type="checkbox" name="soloErrores" value="true" id="errores" checked="@((bool)ViewBag.SoloErrores)" />
            <label class="form-check-label" for="errores">Solo errores</label>
        </div>
        <div class="col-md-1"><button class="btn btn-outline-primary w-100"><i class="bi bi-search"></i></button></div>
    </form>
    <div class="table-responsive">
        <table class="table table-sm table-hover">
            <thead><tr><th>Fecha y hora</th><th>Usuario</th><th>Método y endpoint</th><th>Código</th><th class="text-end">Duración</th><th>Correlation ID</th><th>Excepción</th></tr></thead>
            <tbody>
            @foreach (var l in Model)
            {
                <tr>
                    <td class="text-nowrap">@l.Fecha.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@l.Usuario</td>
                    <td class="mono">@l.Metodo @l.Endpoint</td>
                    <td><span class="badge @Ui.ClaseHttp(l.Codigo)">@l.Codigo</span></td>
                    <td class="text-end">@l.DuracionMs ms</td>
                    <td class="mono"><a asp-action="Logs" asp-route-correlationId="@l.CorrelationId">@l.CorrelationId</a></td>
                    <td class="small">
                        @if (l.Excepcion != null)
                        {
                            <details>
                                <summary class="text-danger">@l.Excepcion</summary>
                                <pre class="small mb-0" style="white-space:pre-wrap;max-width:520px">@l.Detalle</pre>
                            </details>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        @if (!Model.Any()) { <p class="text-muted mb-0">Sin registros.</p> }
    </div>
</div>
