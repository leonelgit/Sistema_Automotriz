@model RepuestoSaveDto
@{
    int? id = ViewBag.Id;
    string? foto = ViewBag.FotoRuta;
    ViewData["Title"] = id.HasValue ? "Editar repuesto" : "Nuevo repuesto";
}
<div class="encabezado"><h1>@ViewData["Title"]</h1></div>
<div class="panel" style="max-width:820px">
    <form asp-action="@(id.HasValue ? "Editar" : "Crear")" asp-route-id="@id" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Version" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="row g-3">
            <div class="col-md-4"><label asp-for="Codigo" class="form-label">Código</label><input asp-for="Codigo" class="form-control text-uppercase" /><span asp-validation-for="Codigo" class="text-danger small"></span></div>
            <div class="col-md-8"><label asp-for="Nombre" class="form-label">Nombre</label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="text-danger small"></span></div>
            <div class="col-12"><label asp-for="Descripcion" class="form-label">Descripción</label><textarea asp-for="Descripcion" rows="2" class="form-control"></textarea></div>
            <div class="col-md-4"><label asp-for="Categoria" class="form-label">Categoría</label><input asp-for="Categoria" class="form-control" /><span asp-validation-for="Categoria" class="text-danger small"></span></div>
            <div class="col-md-4"><label asp-for="Marca" class="form-label">Marca</label><input asp-for="Marca" class="form-control" /><span asp-validation-for="Marca" class="text-danger small"></span></div>
            <div class="col-md-4"><label asp-for="Precio" class="form-label">Precio ($)</label><input asp-for="Precio" type="number" step="0.01" min="0" value="@(Model.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture))" class="form-control" /></div>
            <div class="col-md-4">
                <label asp-for="Existencias" class="form-label">Existencias</label>
                @if (id.HasValue)
                {
                    <input value="@Model.Existencias" class="form-control" disabled />
                    <input type="hidden" asp-for="Existencias" />
                    <div class="form-text">Cambian solo con entradas y salidas.</div>
                }
                else
                {
                    <input asp-for="Existencias" type="number" min="0" class="form-control" />
                }
            </div>
            <div class="col-md-4"><label asp-for="StockMinimo" class="form-label">Stock mínimo</label><input asp-for="StockMinimo" type="number" min="0" class="form-control" /></div>
            <div class="col-12">
                <label class="form-label">Fotografía (JPG/PNG, máx. 5 MB)</label>
                @if (!string.IsNullOrEmpty(foto)) { <div class="mb-2"><img src="@Ui.Img(foto)" alt="Foto actual" style="max-height:110px;border-radius:6px" /></div> }
                <input type="file" name="foto" class="form-control" accept=".jpg,.jpeg,.png" />
                <div class="aviso-archivo text-warning small"></div>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>
