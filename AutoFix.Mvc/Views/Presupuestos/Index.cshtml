@model List<PresupuestoDto>
@{
    ViewData["Title"] = User.IsInRole(Roles.Cliente) ? "Mis presupuestos" : "Presupuestos";
    EstadoPresupuesto? estado = ViewBag.Estado;
}
<div class="encabezado">
    <div><h1>@ViewData["Title"]</h1><p class="sub">Los presupuestos se crean desde el detalle de cada orden.</p></div>
</div>
<div class="panel">
    <div class="btn-group mb-3" role="group">
        <a asp-action="Index" class="btn btn-sm @(estado == null ? "btn-primary" : "btn-outline-primary")">Todos</a>
        @foreach (var e in Enum.GetValues<EstadoPresupuesto>())
        {
            <a asp-action="Index" asp-route-estado="@e" class="btn btn-sm @(estado == e ? "btn-primary" : "btn-outline-primary")">@Ui.TextoPresupuesto(e)</a>
        }
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Orden</th><th>Vehículo</th><th>Cliente</th><th>Fecha</th><th class="text-end">Total</th><th>Estado</th><th>Resuelto por</th></tr></thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td><a asp-action="Detalle" asp-route-id="@p.Id" class="fw-semibold">@p.NumeroOrden</a></td>
                    <td>@p.VehiculoDescripcion</td>
                    <td>@p.ClienteNombre</td>
                    <td>@Ui.FechaCorta(p.FechaCreacion)</td>
                    <td class="text-end">@Ui.Dinero(p.Total)</td>
                    <td><span class="badge @Ui.ClasePresupuesto(p.Estado)">@Ui.TextoPresupuesto(p.Estado)</span></td>
                    <td>@(p.ResueltoPor ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
        @if (!Model.Any()) { <p class="text-muted">No hay presupuestos.</p> }
    </div>
</div>
