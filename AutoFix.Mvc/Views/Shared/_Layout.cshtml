@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var act = ViewContext.RouteData.Values["action"]?.ToString();
    string Activo(string c, string? a = null) => ctrl == c && (a == null || act == a) ? "activo" : "";
    var esCliente = User.IsInRole(Roles.Cliente);
    var esEmpleado = User.EsEmpleado();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AutoFix</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Semi+Condensed:wght@600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="af-shell">
    <aside class="af-sidebar">
        <div class="af-marca">
            <div class="nombre"><i class="bi bi-wrench-adjustable"></i> AutoFix</div>
            <div class="lema">Centro de servicio automotriz</div>
        </div>
        <nav class="af-nav">
            <a class="@Activo("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>

            @if (esCliente)
            {
                <div class="grupo">Mi cuenta</div>
                <a class="@Activo("Clientes")" asp-controller="Clientes" asp-action="Mio"><i class="bi bi-person"></i> Mis datos</a>
                <a class="@Activo("Vehiculos")" asp-controller="Vehiculos" asp-action="Index"><i class="bi bi-car-front"></i> Mis vehículos</a>
                <a class="@Activo("Ordenes")" asp-controller="Ordenes" asp-action="Index"><i class="bi bi-clipboard-check"></i> Mis reparaciones</a>
                <a class="@Activo("Presupuestos")" asp-controller="Presupuestos" asp-action="Index"><i class="bi bi-receipt"></i> Mis presupuestos</a>
            }
            @if (esEmpleado)
            {
                <div class="grupo">Recepción</div>
                <a class="@Activo("Clientes")" asp-controller="Clientes" asp-action="Index"><i class="bi bi-people"></i> Clientes</a>
                <a class="@Activo("Vehiculos")" asp-controller="Vehiculos" asp-action="Index"><i class="bi bi-car-front"></i> Vehículos</a>

                <div class="grupo">Taller</div>
                <a class="@Activo("Ordenes")" asp-controller="Ordenes" asp-action="Index"><i class="bi bi-clipboard-check"></i> Órdenes</a>
                <a class="@Activo("Presupuestos")" asp-controller="Presupuestos" asp-action="Index"><i class="bi bi-receipt"></i> Presupuestos</a>
                <a class="@Activo("Mecanicos")" asp-controller="Mecanicos" asp-action="Index"><i class="bi bi-person-gear"></i> Mecánicos</a>
                <a class="@Activo("Evidencias")" asp-controller="Evidencias" asp-action="Index"><i class="bi bi-camera"></i> Evidencias</a>

                <div class="grupo">Inventario</div>
                <a class="@Activo("Inventario")" asp-controller="Inventario" asp-action="Index"><i class="bi bi-box-seam"></i> Repuestos</a>
                <a class="@Activo("Movimientos")" asp-controller="Movimientos" asp-action="Index"><i class="bi bi-arrow-left-right"></i> Movimientos</a>
            }
            @if (User.EsAlguno(Roles.Administrador, Roles.Supervisor))
            {
                <div class="grupo">Control</div>
                <a class="@Activo("Reportes", "Index")" asp-controller="Reportes" asp-action="Index"><i class="bi bi-bar-chart"></i> Reportes</a>
                <a class="@Activo("Reportes", "Logs")" asp-controller="Reportes" asp-action="Logs"><i class="bi bi-journal-code"></i> Logs</a>
            }
            @if (User.IsInRole(Roles.Administrador))
            {
                <a class="@Activo("Usuarios")" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-shield-lock"></i> Usuarios</a>
            }
        </nav>
        <div class="af-usuario">
            <div>@User.Nombre()</div>
            <div class="rol">@User.Rol()</div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
                <button class="btn btn-sm btn-outline-light"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</button>
            </form>
        </div>
    </aside>

    <main class="af-main">
        <partial name="_Alertas" />
        @RenderBody()
    </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
